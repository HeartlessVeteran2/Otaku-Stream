<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required by ExoPlayer.setWakeMode: it acquires a partial WakeLock (and a WifiLock for the
         NETWORK mode) through PowerManager.newWakeLock, which throws SecurityException without
         this. The wake mode is what keeps backgrounded or screen-off playback from being starved
         when the CPU idles. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ gates the media-playback notification behind a runtime grant; requested on
         first playback in PlayerScreen. Playback continues whether or not it's granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.otakustream.core.player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
