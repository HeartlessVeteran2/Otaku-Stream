<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MainActivity calls enableEdgeToEdge(), which overrides android:statusBarColor at runtime
         regardless of what's set here — the root Surface color (set to
         MaterialTheme.colorScheme.background) is what actually determines the tone seen behind the
         transparent status bar. windowBackground matches it so the frames between the splash
         dismissing and Compose's first draw are the right colour rather than platform grey. -->
    <style name="Theme.OtakuStream" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- The same theme with the choice made explicitly rather than by resource qualifier.
         MainActivity reads the stored Appearance mode before super.onCreate() and calls setTheme()
         with one of these, because @color/window_background resolves through values-night — i.e.
         by the *phone's* night setting, which is the wrong answer for someone who has overridden
         it in the app. Without this, forcing Light on a dark phone painted a dark frame on every
         cold start before Compose drew. -->
    <style name="Theme.OtakuStream.Dark" parent="Theme.OtakuStream">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>

    <style name="Theme.OtakuStream.Light" parent="Theme.OtakuStream">
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <!-- Cold-start splash, handing off to the app theme. Uses the same padded icon asset as the
         launcher so the mark sits inside the splash icon's circular reveal.

         This one genuinely cannot follow an in-app override on its own: the system draws it before
         the app has a process, so no app code has run to correct it. On API 31+ that is handled
         instead by UiModeManager.setApplicationNightMode(), which tells the platform the app's mode
         so its own resource resolution — this splash included — matches. Below 31 the splash
         follows the phone and the window behind it is corrected by setTheme(); one splash frame is
         the residue, and there is no API to reach it. -->
    <style name="Theme.OtakuStream.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.OtakuStream</item>
    </style>
</resources>
