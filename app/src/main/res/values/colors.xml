<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launcher icon's own background. Fixed, not theme-dependent: a launcher icon is drawn
         by the system on someone else's wallpaper, so it keeps the app's navy identity rather
         than following the in-app scheme. -->
    <color name="ic_launcher_background">#0B1220</color>

    <!-- The window background behind Compose, and the splash. Matches the light scheme's
         background (LightBackground in Color.kt); values-night carries the dark one. These are
         what the frames between the splash dismissing and Compose's first draw are painted with,
         so a mismatch here shows up as a flash of the wrong colour on every cold start. -->
    <color name="window_background">#FCFAF7</color>
</resources>
